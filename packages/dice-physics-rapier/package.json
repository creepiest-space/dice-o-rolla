{
  "name": "@dice-o-rolla/dice-physics-rapier",
  "version": "0.0.0",
  "description": "Rapier 3D physics backend for physical dice simulation.",
  "keywords": [
    "dice",
    "physics",
    "rapier",
    "wasm"
  ],
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dice-o-rolla/dice-core": "workspace:*",
    "@dice-o-rolla/dice-physics": "workspace:*",
    "@dimforge/rapier3d-compat": "^0.20.0"
  },
  "devDependencies": {
    "@dice-o-rolla/dice-geometry": "workspace:*"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
