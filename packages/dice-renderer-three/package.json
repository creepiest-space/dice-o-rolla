{
  "name": "@dice-o-rolla/dice-renderer-three",
  "version": "0.0.0",
  "description": "Three.js WebGL renderers for animated physical dice.",
  "keywords": [
    "dice",
    "renderer",
    "three.js",
    "webgl"
  ],
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dice-o-rolla/dice-geometry": "workspace:*",
    "@dice-o-rolla/dice-renderer": "workspace:*",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
