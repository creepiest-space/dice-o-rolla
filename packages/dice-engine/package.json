{
  "name": "@dice-o-rolla/dice-engine",
  "version": "0.1.1",
  "description": "Framework-neutral physical dice engine with Rapier and Three.js browser adapters.",
  "keywords": [
    "dice",
    "dice-roller",
    "physics",
    "rpg",
    "three.js",
    "typescript"
  ],
  "homepage": "https://github.com/creepiest-space/dice-o-rolla#readme",
  "bugs": {
    "url": "https://github.com/creepiest-space/dice-o-rolla/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/creepiest-space/dice-o-rolla.git",
    "directory": "packages/dice-engine"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dice-o-rolla/dice-core": "workspace:*",
    "@dice-o-rolla/dice-geometry": "workspace:*",
    "@dice-o-rolla/dice-physics": "workspace:*",
    "@dice-o-rolla/dice-physics-rapier": "workspace:*",
    "@dice-o-rolla/dice-renderer": "workspace:*",
    "@dice-o-rolla/dice-renderer-three": "workspace:*"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
