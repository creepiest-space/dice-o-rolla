{
  "name": "@dice-o-rolla/dice-assets-tools",
  "version": "0.4.0",
  "description": "Node.js and Bun tools for authoring connected dice textures and KTX2 skin sets.",
  "keywords": [
    "assets",
    "dice",
    "skins",
    "sounds",
    "typescript"
  ],
  "homepage": "https://github.com/creepiest-space/dice-o-rolla#readme",
  "bugs": {
    "url": "https://github.com/creepiest-space/dice-o-rolla/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/creepiest-space/dice-o-rolla.git",
    "directory": "packages/dice-assets-tools"
  },
  "bin": {
    "dice-assets": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test ./test/unit",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "bun test ./test/integration"
  },
  "dependencies": {
    "@dice-o-rolla/dice-assets": "workspace:*",
    "@dice-o-rolla/dice-geometry": "workspace:*",
    "@dice-o-rolla/dice-renderer-three": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
