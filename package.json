{
  "name": "dice-o-rolla",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:dice-engine": "turbo build --filter=@creepiest-space/dice-engine...",
    "pack:dice-engine": "bun ./scripts/package-dice-engine.ts",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:types": "oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "deadcode": "knip --config ./knip.config.mts",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "check:full": "bun run check && bun run lint:types && bun run test && bun run deadcode && bun run build",
    "commit": "bunx --bun czg --config=./cz.config.mts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^20.19.0",
    "czg": "^1.13.0",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14"
}
